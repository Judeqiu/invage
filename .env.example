# ── LLM ────────────────────────────────────────────────────────────────
# Multi-LLM smart route (Utarus v1.5+): DeepSeek for daily chat, Kimi k3
# for images + heavy analysis. Requires BOTH keys. When PROFILES is set,
# ROUTING is required and UTARUS_LLM_PROVIDER is ignored for agent turns.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
# vision/heavy default model is k3 (Kimi Coding) when model is omitted.
UTARUS_LLM_PROFILES={"daily":{"provider":"deepseek"},"vision":{"provider":"kimi","model":"k3"},"heavy":{"provider":"kimi","model":"k3"}}
UTARUS_LLM_ROUTING={"default":"daily","has_images":"vision","utility":"daily","heavy":"heavy"}
# Accountant agent code sets llmRouting.default=heavy (Kimi k3). Optional ops override:
# UTARUS_LLM_ROUTING_BY_AGENT={"accountant":{"default":"heavy"}}
# Optional: length/keyword heuristics → heavy (Kimi k3) for Invester/others
UTARUS_LLM_ROUTE_HEAVY_MIN_CHARS=4000
UTARUS_LLM_ROUTE_HEAVY_KEYWORDS=deep dive,comprehensive analysis,portfolio analysis,full thesis,step by step valuation,undervalued screen,risk matrix
# Legacy single-provider (omit PROFILES/ROUTING entirely):
# UTARUS_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=

# ── Firecrawl (web search / scrape tool — Utarus framework) ────────────
# Get a key at https://www.firecrawl.dev — required for the firecrawl tool.
FIRECRAWL_API_KEY=

# ── Singapore property intel (HDB comps via data.gov.sg) ────────────────
# Production: set DATA_GOV_SG_API_KEY for higher rate limits (strongly recommended).
# Portal: https://data.gov.sg/signin → API key
# DATA_GOV_SG_API_KEY=
# Optional override for 2017+ slice only (default d_8b84c4ee58e3cfc0ece0d773c8ca6abc).
# Full history 1990–present is catalogued in property_intel (collection 189).
# HDB_RESALE_RESOURCE_ID=d_8b84c4ee58e3cfc0ece0d773c8ca6abc
# URA Data Service (private residential sold + car parks) — eservice.ura.gov.sg
# Register: https://eservice.ura.gov.sg/maps/api/reg.html
# URA_ACCESS_KEY=
# Optional override (default https://eservice.ura.gov.sg):
# URA_BASE_URL=https://eservice.ura.gov.sg

# ── Framework (Utarus) ──────────────────────────────────────────────────
UTARUS_AGENT_NAME=Invester
UTARUS_LOADED_BY_HOST=1

# Prefer ABSOLUTE path so agent + BinDrive share host data
# (relative ./data resolves under node_modules/utarus).
# Example: UTARUS_DATA_ROOT=/opt/invage/data
UTARUS_DATA_ROOT=

# Public base URL for signed BinDrive report links.
# Required for save_report signed view URLs.
UTARUS_REPORTS_URL=

# Public origin for Checkout return URLs (only needed when paywall is on).
# Production: https://chat.investor.lextok.com
# UTARUS_PUBLIC_BASE_URL=

# ── Billing / Stripe paywall (utarus ≥ 1.18) — NOT ENABLED YET ──────────
# Credit rates live in src/credit-rates.ts (required at boot even when off).
# Do not set UTARUS_BILLING_ENABLED until Stripe prices exist for Invage.
# UTARUS_BILLING_ENABLED=true
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_YEARLY=price_...
# Webhook endpoint (agent process + WEBAPP_PORT):
#   POST {UTARUS_PUBLIC_BASE_URL}/api/billing/webhook

# ── Telegram (Binary-style) — optional ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Optional — deep-link username without getMe (e.g. lexinvestor_bot)
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram numeric user IDs (bootstrap admins)
TELEGRAM_ADMIN_IDS=

# ── Slack (Marie-style Socket Mode) — optional ──────────────────────────
# Fast path: create the app from slack-app-manifest.yaml
#   https://api.slack.com/apps → Create New App → From an app manifest
# Then copy tokens (see comments in slack-app-manifest.yaml).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs (e.g. U012ABCDEF)
SLACK_ADMIN_IDS=

# ── Process mode ────────────────────────────────────────────────────────
# BOT_ONLY=true           — no CLI; keep Telegram and/or Slack running (production)
# TELEGRAM_ONLY=true      — Telegram only, no CLI, no Slack
# SLACK_ONLY=true         — Slack only, no CLI, no Telegram
# BOT_ONLY=true

# ── BinDrive webapp (separate process: npm run webapp) ──────────────────
WEBAPP_PORT=3001
SESSION_SECRET=change-me-in-production
WEBAPP_ADMIN_CREDENTIALS={"admin": "change-me"}

# ── Public onboard (investor.lextok.com → Slack) ────────────────────────
# Public landing URL shown in /bind help replies.
INVAGE_PUBLIC_LANDING_URL=https://investor.lextok.com
# BIND token time-to-live, in minutes. Must be a positive integer.
INVAGE_ONBOARD_TOKEN_TTL_MIN=15
# Slack shared invite URL (Workspace settings → Invitations → Create invite link).
# Returned to the browser after registration so users can join the space.
INVAGE_SLACK_WORKSPACE_INVITE_URL=
