{
  "description": "Local learning from Velovest broker, validation and deployment rounds; adapted from Binary.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_round_learning.py\" observe",
            "statusMessage": "Recording development outcome"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_round_learning.py\" finish",
            "statusMessage": "Saving round lessons"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_round_learning.py\" context",
            "additionalContextLimit": 0,
            "statusMessage": "Loading relevant round lessons"
          }
        ]
      }
    ]
  }
}
